// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  password           String
  role               String    @default("user")
  isVerified         Boolean   @default(false)
  verificationToken  String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  pushToken          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  loyaltyPoints      Int       @default(0)
  
  // Consent management (GDPR compliance)
  marketingConsent           Boolean   @default(false)  // Newsletter, promotions
  behaviorTrackingConsent    Boolean   @default(false)  // Order pattern analysis
  reminderNotificationsConsent Boolean @default(false)  // "Pizza?" type reminders
  consentGivenAt             DateTime? // When consent was given
  consentUpdatedAt           DateTime? // Last time consent was updated
  
  orders             Order[]
  addresses          Address[]
  paymentMethods     PaymentMethod[]
  favorites          Favorite[]
  cartItems          CartItem[]
  createdTokens      VisitToken[] @relation("CreatedTokens")
  redeemedTokens     VisitToken[] @relation("RedeemedTokens")
  behaviorProfile    BehaviorProfile?
  notificationLogs   NotificationLog[]
}

model Address {
  id         Int      @id @default(autoincrement())
  label      String
  street     String
  city       String
  postalCode String
  phone      String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  orders     Order[]
  temporary  Boolean  @default(false) // If true, not saved to user profile (one-time use)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PaymentMethod {
  id                    Int      @id @default(autoincrement())
  user                  User     @relation(fields: [userId], references: [id])
  userId                Int
  type                  String   // e.g. Card, PayPal
  stripePaymentMethodId String?  @unique // Stripe PaymentMethod ID for reusable payments
  cardNumber            String?  // Last 4 digits only (for display)
  cardHolder            String?
  expiry                String?
  brand                 String?  // Visa, MasterCard, etc.
  paypalEmail           String?
  isDefault             Boolean  @default(false)
  temporary             Boolean  @default(false) // If true, not saved to user profile (one-time use)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MenuCategory {
  id      Int    @id @default(autoincrement())
  name    String
  nameEn  String?
  nameDe  String?
  items   MenuItem[]
}

model MenuItem {
  id          Int    @id @default(autoincrement())
  name        String
  nameEn      String?
  nameDe      String?
  description String?
  descriptionEn String?
  descriptionDe String?
  price       Float
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  categoryId  Int
  imageUrl    String?
  isVegetarian Boolean @default(false)
  isVegan     Boolean @default(false)
  isGlutenFree Boolean @default(false)
  isSpicy     Boolean @default(false)
  allergens   String? // Comma-separated list of allergens
  loyaltyPointsMultiplier Float @default(1.0) // Multiplier for loyalty points (e.g., 2.0 = double points)
  
  // Cooking preferences configuration
  hasCookingOptions Boolean @default(false) // Whether to show cooking preference options
  allowedCookingPreferences String[] @default([]) // e.g., ["rare", "medium", "well_done"]
  
  orderItems  OrderItem[]
  favorites   Favorite[]
  cartItems   CartItem[]
  modifiers   MenuItemModifier[]
  ingredients MenuItemIngredient[]
}

model MenuItemModifier {
  id          Int      @id @default(autoincrement())
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId  Int
  name        String   // "Extra Cheese", "No Tomato", "Well-Done"
  nameEn      String?  // English translation
  nameDe      String?  // German translation
  price       Float    // Additional cost (0.00 for removals/preferences)
  type        String   @default("addition") // "addition", "removal", "preparation"
  category    String?  // Optional grouping: "Toppings", "Proteins", "Sauces", "Cooking Style"
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  maxQuantity Int      @default(5) // Max times this can be added
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  orderItemModifiers OrderItemModifier[]
  cartItemModifiers  CartItemModifier[]
  
  @@index([menuItemId])
  @@index([type])
}

model Order {
  id         Int        @id @default(autoincrement())
  user       User?      @relation(fields: [userId], references: [id])
  userId     Int?
  address    Address?   @relation(fields: [addressId], references: [id])
  addressId  Int?
  items      OrderItem[]
  status     String     @default("pending")
  estimatedDeliveryTime DateTime?
  loyaltyPointsAwarded Int @default(0)
  // Payment & Refund fields
  paymentIntentId String?   // Stripe PaymentIntent ID
  refundId        String?   // Stripe Refund ID
  refundStatus    String?   // pending, succeeded, failed, cancelled
  refundAmount    Float?    // Amount refunded in currency units
  refundedAt      DateTime? // When the refund was processed
  
  // Driver & Tracking fields
  driverName              String?   // Driver name
  driverPhone             String?   // Driver phone
  driverLatitude          Float?    // Driver's current latitude
  driverLongitude         Float?    // Driver's current longitude
  driverLocationUpdatedAt DateTime? // Last location update timestamp
  
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  
  statusHistory    OrderStatusHistory[]
  locationHistory  DriverLocationHistory[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  menuItem  MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId Int
  quantity  Int      @default(1)
  specialInstructions String? // Free-text customization (max 200 chars)
  cookingPreference String? // Selected cooking option: "rare", "medium", "well_done", etc.
  cookingNotes String? // Additional cooking instructions text area
  loyaltyPointsMultiplier Float @default(1.0) // Store multiplier at time of order
  modifiers OrderItemModifier[]
  ingredientCustomizations OrderItemIngredient[]
}

model OrderItemModifier {
  id           Int              @id @default(autoincrement())
  orderItem    OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId  Int
  modifier     MenuItemModifier @relation(fields: [modifierId], references: [id])
  modifierId   Int
  quantity     Int              @default(1)
  priceAtOrder Float            // Snapshot of price at time of order
  createdAt    DateTime         @default(now())
  
  @@index([orderItemId])
}

model Favorite {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId Int
  createdAt  DateTime @default(now())

  @@unique([userId, menuItemId])
}

model CartItem {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId Int
  quantity   Int      @default(1)
  specialInstructions String? // Free-text customization (max 200 chars)
  cookingPreference String? // Selected cooking option
  cookingNotes String? // Additional cooking instructions
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  modifiers  CartItemModifier[]
  ingredientCustomizations CartItemIngredient[]

  @@index([userId, menuItemId])
}

model CartItemModifier {
  id         Int              @id @default(autoincrement())
  cartItem   CartItem         @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  cartItemId Int
  modifier   MenuItemModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  modifierId Int
  quantity   Int              @default(1)
  createdAt  DateTime         @default(now())
  
  @@index([cartItemId])
}

model Settings {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  value         String
  description   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model VisitToken {
  id                  Int       @id @default(autoincrement())
  code                String    @unique
  points              Int
  createdBy           User?     @relation("CreatedTokens", fields: [createdById], references: [id])
  createdById         Int?
  createdAt           DateTime  @default(now())
  expiresAt           DateTime?
  redeemedBy          User?     @relation("RedeemedTokens", fields: [redeemedById], references: [id])
  redeemedById        Int?
  redeemedAt          DateTime?
  isActive            Boolean   @default(true)
  restaurantLocation  String?
  notes               String?
  
  @@index([code])
  @@index([isActive])
}

  model AllowedPostalCode {
    id         Int      @id @default(autoincrement())
    postalCode String   @unique
    city       String
    district   String?
    radiusKm   Float?
    sortOrder  Int      @default(0)
    isActive   Boolean  @default(true)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([isActive, sortOrder])
  }

model BehaviorProfile {
  id                    Int       @id @default(autoincrement())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                Int       @unique
  
  // Pattern detection
  mostOrderedItems      Json?     // Array of {menuItemId, name, count, lastOrdered}
  commonOrderTimes      Json?     // Array of {hour, dayOfWeek, count}
  averageOrderValue     Float?
  lastOrderDate         DateTime?
  orderFrequencyDays    Float?    // Average days between orders
  
  // Reminder settings
  remindersSent         Int       @default(0)
  lastReminderSent      DateTime?
  remindersOptOut       Boolean   @default(false)
  
  updatedAt             DateTime  @updatedAt
  createdAt             DateTime  @default(now())
  
  @@index([userId])
}

model NotificationLog {
  id              Int       @id @default(autoincrement())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  type            String    // 'reminder', 'promotion', 'order_update'
  templateId      String?
  title           String
  message         String
  delivered       Boolean   @default(false)
  opened          Boolean   @default(false)
  sentAt          DateTime  @default(now())
  openedAt        DateTime?
  
  @@index([userId])
  @@index([type])
  @@index([sentAt])
}

// Master ingredient list
model Ingredient {
  id           Int       @id @default(autoincrement())
  name         String    // Primary name
  nameEn       String?   // English translation
  nameDe       String?   // German translation
  category     String    // "protein", "vegetable", "sauce", "bread", "cheese", "extras"
  pricePerUnit Float     @default(0) // Price for each EXTRA unit
  isAvailable  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  menuItemIngredients  MenuItemIngredient[]
  orderItemIngredients OrderItemIngredient[]
  cartItemIngredients  CartItemIngredient[]
  
  @@index([category])
  @@index([isAvailable])
}

// Junction table: Menu item's recipe (which ingredients it contains by default)
model MenuItemIngredient {
  id              Int       @id @default(autoincrement())
  menuItem        MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId      Int
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId    Int
  defaultQuantity Int       @default(1) // How many come by default in the recipe
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([menuItemId, ingredientId])
  @@index([menuItemId])
  @@index([ingredientId])
}

// Stores customer's ingredient customizations in their order
model OrderItemIngredient {
  id           Int        @id @default(autoincrement())
  orderItem    OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderItemId  Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Int        // Customer's chosen quantity (can be 0 for removal)
  
  @@unique([orderItemId, ingredientId])
  @@index([orderItemId])
}

// Stores customer's ingredient customizations in cart
model CartItemIngredient {
  id           Int        @id @default(autoincrement())
  cartItem     CartItem   @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  cartItemId   Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Int        // Customer's chosen quantity (can be 0 for removal)
  
  @@unique([cartItemId, ingredientId])
  @@index([cartItemId])
}

// Order status history for tracking
model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  status    String   // "pending", "confirmed", "preparing", "ready", "out_for_delivery", "delivered", "cancelled"
  message   String?  // Optional message: "Driver picked up your order"
  timestamp DateTime @default(now())
  
  @@index([orderId])
  @@index([timestamp])
}

// Driver location history for tracking deliveries
model DriverLocationHistory {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  latitude  Float
  longitude Float
  timestamp DateTime @default(now())
  
  @@index([orderId])
  @@index([timestamp])
}
