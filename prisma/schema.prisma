// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  password           String
  role               String    @default("user")
  isVerified         Boolean   @default(false)
  verificationToken  String?
  resetToken         String?
  resetTokenExpiry   DateTime?
  pushToken          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  loyaltyPoints      Int       @default(0)
  orders             Order[]
  reservations       Reservation[]
  addresses          Address[]
  paymentMethods     PaymentMethod[]
  favorites          Favorite[]
  createdTokens      VisitToken[] @relation("CreatedTokens")
  redeemedTokens     VisitToken[] @relation("RedeemedTokens")
}
model Address {
  id         Int      @id @default(autoincrement())
  label      String
  street     String
  city       String
  postalCode String
  phone      String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  orders     Order[]
  temporary  Boolean  @default(false) // If true, not saved to user profile (one-time use)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PaymentMethod {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  type       String   // e.g. Card, PayPal
  cardNumber String?  // encrypted or masked
  cardHolder String?
  expiry     String?
  brand      String?  // Visa, MasterCard, etc.
  paypalEmail String?
  isDefault  Boolean  @default(false)
  temporary  Boolean  @default(false) // If true, not saved to user profile (one-time use)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MenuCategory {
  id    Int    @id @default(autoincrement())
  name  String
  items MenuItem[]
}

model MenuItem {
  id          Int    @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  categoryId  Int
  imageUrl    String?
  isVegetarian Boolean @default(false)
  isVegan     Boolean @default(false)
  isGlutenFree Boolean @default(false)
  isSpicy     Boolean @default(false)
  allergens   String? // Comma-separated list of allergens
  loyaltyPointsMultiplier Float @default(1.0) // Multiplier for loyalty points (e.g., 2.0 = double points)
  orderItems  OrderItem[]
  favorites   Favorite[]
}

model Order {
  id         Int        @id @default(autoincrement())
  user       User       @relation(fields: [userId], references: [id])
  userId     Int
  address    Address?   @relation(fields: [addressId], references: [id])
  addressId  Int?
  items      OrderItem[]
  status     String     @default("pending")
  estimatedDeliveryTime DateTime?
  loyaltyPointsAwarded Int @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  menuItem  MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId Int
  quantity  Int      @default(1)
  loyaltyPointsMultiplier Float @default(1.0) // Store multiplier at time of order
}

model Reservation {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  tableNum   Int
  time       DateTime
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Favorite {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  menuItemId Int
  createdAt  DateTime @default(now())

  @@unique([userId, menuItemId])
}

model Settings {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  value         String
  description   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model VisitToken {
  id                  Int       @id @default(autoincrement())
  code                String    @unique
  points              Int
  createdBy           User      @relation("CreatedTokens", fields: [createdById], references: [id])
  createdById         Int
  createdAt           DateTime  @default(now())
  expiresAt           DateTime
  redeemedBy          User?     @relation("RedeemedTokens", fields: [redeemedById], references: [id])
  redeemedById        Int?
  redeemedAt          DateTime?
  isActive            Boolean   @default(true)
  restaurantLocation  String?
  notes               String?
  
  @@index([code])
  @@index([isActive, expiresAt])
}
